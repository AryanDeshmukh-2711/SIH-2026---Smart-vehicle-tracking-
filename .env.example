# Copy to .env before starting anything:  cp .env.example .env
# Used by both docker compose and the API.

# ---------------------------------------------------------------- Postgres --
POSTGRES_USER=himgati
POSTGRES_PASSWORD=himgati
POSTGRES_DB=himgati
POSTGRES_PORT=5433
DATABASE_URL=postgresql://himgati:himgati@localhost:5433/himgati?schema=public

# ------------------------------------------------------------------- Redis --
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -------------------------------------------------------------------- MQTT --
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_URL=mqtt://localhost:1883

# --------------------------------------------------------------------- API --
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API and open a socket.
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------- GPS / rules --
# Readings implying a speed above this are discarded as impossible (SRS FR-3).
#
# The real-world value is 120. It is raised here ONLY because the demo simulator
# compresses time by SIM_TIME_SCALE: a bus covering 12 minutes of road in one
# minute of wall clock genuinely implies ~12x the speed, and the validator — which
# has no idea it is being fed a simulation — would correctly reject every reading.
# Set this back to 120 the moment real AIS-140 devices are the source.
GPS_MAX_SPEED_KMPH=1440
# A reported fix further than this from the route shape is rejected as off-route.
GPS_MAX_OFFROUTE_M=250
# How often the ETA engine recomputes every running trip (SRS FR-11).
ETA_REFRESH_MS=30000

# ---------------------------------------------------------------- Simulator --
# Wall-clock multiplier so a 7-hour Shimla–Manali run is watchable in a demo.
# Set to 1 for true-time behaviour.
SIM_TIME_SCALE=12
# How often each simulated bus reports, in real milliseconds (SRS FR-1 = 10s).
SIM_REPORT_MS=2000

# ---------------------------------------------------------------------- auth --
# Generate your own before deploying:  openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

OTP_TTL_SEC=300
OTP_MAX_REQUESTS=5
OTP_REQUEST_WINDOW_SEC=900

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SEC=60
