{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@routify/shared": ["../packages/shared/src/index.ts"],
      "@routify/shared/data": ["../packages/shared/src/data/index.ts"],
      "@routify/shared/*": ["../packages/shared/src/*.ts"]
    }
  },
  "include": ["src", "../packages/shared/src"]
}
