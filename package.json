{
  "name": "routify",
  "version": "1.0.0",
  "private": true,
  "description": "Routify \u2014 smart public transport & tourism platform for Himachal Pradesh",
  "workspaces": [
    "packages/*",
    "web",
    "api"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "npm run db:migrate --workspace @routify/api",
    "db:seed": "npm run db:seed --workspace @routify/api",
    "dev:api": "npm run dev --workspace @routify/api",
    "dev:sim": "npm run simulator --workspace @routify/api",
    "dev:web": "npm run dev --workspace @routify/web",
    "build": "npm run build --workspace @routify/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:reset": "docker exec routify-redis redis-cli FLUSHALL"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
